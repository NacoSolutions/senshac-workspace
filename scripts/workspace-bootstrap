#!/usr/bin/env bash
set -euo pipefail
root="${SENSHAC_WORKSPACE_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
test -f "$root/.config/workspace.toml"
test -x "$root/scripts/workspace-check"
test -x "$root/scripts/workspace-status"
test -x "$root/scripts/wx"
"$root/scripts/workspace-check"
"$root/scripts/workspace-status"
# Seeds and Mulch JSONL rows are rewritten by id; union would duplicate
# contradictory updates. Register the Warren-compatible three-way driver.
git -C "$root" config merge.seeds-jsonl.driver "bun $root/scripts/merge-seeds-jsonl.ts %O %A %B"
